{
  "name": "@flock/sim",
  "version": "0.0.0",
  "description": "Deterministic FLOCK simulation core — fixed-point Q16.16, seeded RNG, lockstep-safe. Runs identically on client and server.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "tsc -b && node --test --experimental-strip-types test/*.test.ts",
    "clean": "rm -rf dist *.tsbuildinfo"
  }
}
