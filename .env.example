# FLOCK server configuration (§32-34). Copy to .env and edit.

# Session signing secret — REQUIRED in production (>= 16 chars). Rotate to
# invalidate all sessions. A weak/default value throws on boot.
FLOCK_SECRET=change-me-to-a-long-random-string

# Durable storage directory. Unset = in-memory (data lost on restart).
# Mount a volume here in production (or swap in a Postgres/object-store adapter).
FLOCK_DATA=/data

# Match shape
PORT=8787
WORLD=96            # map size (tiles per side)
BOTS=6             # Drifter backfill per match
CHURCHES=1         # Established Church majors per match
FOUNDING=200       # founding spawn-pick window (ticks)
CAPACITY=20        # human seats before a new match opens

# Logging: debug | info | warn | error
LOG_LEVEL=info
